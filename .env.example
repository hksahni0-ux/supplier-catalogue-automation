# Optional: Nemotron rewrites product descriptions. Without a key the supplier's own text is
# used and flagged for review. Copy this file to .env (never commit .env) and add your key.
NVIDIA_API_KEY=
# FCI_COPY_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Composio: Google Drive, Sheets and Gmail for the web app and scheduler
COMPOSIO_API_KEY=

# Web app: signs sign-in links and session cookies (any long random string)
FCI_SESSION_SECRET=
# Optional: who may press Confirm (comma-separated emails); empty = any signed-in user
FCI_OPERATORS=
# Local only: print sign-in links to the terminal instead of emailing them
FCI_DEV_LINKS=
